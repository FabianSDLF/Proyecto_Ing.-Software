# Credenciales de base de datos
DB_URL=jdbc:mysql://localhost:3306/sistema_practicas
DB_USER=root
DB_PASSWORD=

# Puerto de MySQL en el PC al ejecutar Docker (internamente usa db:3306)
MYSQL_HOST_PORT=3307

# Credenciales de correo
MAIL_PASSWORD=

# Chatbot Gemini: modelos en orden de preferencia
GOOGLE_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Contacto de coordinación mostrado en Ayuda (dejar vacío hasta confirmarlo).
SUPPORT_COORDINATOR_NAME=
SUPPORT_COORDINATOR_EMAIL=
SUPPORT_COORDINATOR_PHONE=
