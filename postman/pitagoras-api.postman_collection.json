        {
          "name": "Nivel A - 4. Evaluar planificacion con Rubrica IA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Estructura de evaluacion pedagogica valida', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.aiApproved).to.be.a('boolean');",
                  "    pm.expect(body.score).to.be.a('number').and.within(1.0, 7.0);",
                  "    pm.expect(body.feedback).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(body.momentAnalysis).to.be.an('object');",
                  "    pm.expect(body.momentAnalysis.inicio).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(body.momentAnalysis.desarrollo).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(body.momentAnalysis.cierre).to.be.a('string').and.not.be.empty;",
                  "});",
                  "",
                  "pm.test('Responde dentro del umbral RNF (< 15000 ms)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(15000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
