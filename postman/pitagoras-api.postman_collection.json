        {
          "name": "Nivel B - 5. API Externa LLM (Google Gemini)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK (API key valida y proveedor responde)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('La respuesta es JSON', function () {",
                  "    pm.response.to.have.header('Content-Type');",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Devuelve texto generado no vacio', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.candidates).to.be.an('array').and.not.be.empty;",
                  "    const text = body.candidates[0].content.parts[0].text;",
                  "    pm.expect(text).to.be.a('string').and.not.be.empty;",
                  "});",
                  "",
                  "pm.test('Responde en menos de 10000 ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(10000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-goog-api-key",
                "value": "{{llmApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Responde en una oracion breve que es el momento de inicio de una clase de matematica.\"\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "https://generativelanguage.googleapis.com/v1beta/models/{{geminiModel}}:generateContent",
              "protocol": "https",
              "host": [
                "generativelanguage",
                "googleapis",
                "com"
              ],
              "path": [
                "v1beta",
                "models",
                "{{geminiModel}}:generateContent"
